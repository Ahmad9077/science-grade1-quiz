      "text": "جملة وحدة… ونحكم عليها: صح ولا خطأ؟",
      "hash": "b231717764f21d7b",
      "durationMs": 4006,
      "bytes": 32643
    },
    "ar/q/tick-1": {
      "text": "نختار الجواب الصح… ونحط علامة صح بالمربع اللي جنبه.",
      "hash": "39f3ebd83a7ed960",
      "durationMs": 4537,
      "bytes": 36823
    },
    "ar/q/tick-2": {
      "text": "أي وحدة الصح؟ مربعها ياخذ علامة صح.",
      "hash": "f3d97cab036305d4",
      "durationMs": 3451,
      "bytes": 28255
    },
    "ar/q/tick-3": {
      "text": "نطالع الخيارات كلها زين… وبعدين نختار.",
      "hash": "2da068643947b8d0",
      "durationMs": 3831,
      "bytes": 31180
    },
    "ar/q/word-1": {
      "text": "بين القوسين كلمتين… نحوط الكلمة الصح.",
      "hash": "345d46de69700254",
      "durationMs": 3874,
      "bytes": 31598
    },
    "ar/q/word-2": {
      "text": "أي كلمة تكمل الجملة صح؟ نحوطها.",
      "hash": "53646564ac9d70be",
      "durationMs": 3537,
      "bytes": 28882
    },
    "ar/q/word-3": {
      "text": "كلمة وحدة بس تناسب… خلنا نلقاها.",
      "hash": "df0c6e0d48c0531b",
      "durationMs": 3819,
      "bytes": 31180
    },
    "ar/r/habitats-homes-1": {
      "text": "حيوان بيته الصخور اللي في البحر.",
      "hash": "eb7981cf1d4429eb",
      "durationMs": 2662,
      "bytes": 21776
    },
    "ar/r/habitats-homes-2": {
      "text": "حيوان بيته في الشجر.",
      "hash": "2087bf47b248295c",
      "durationMs": 1974,
      "bytes": 16343
    },
    "ar/r/habitats-homes-3": {
      "text": "حيوان بيته جحر في الأرض.",
      "hash": "64be6c104ab46a18",
      "durationMs": 2688,
      "bytes": 21985
    },
    "ar/r/habitats-homes-4": {
      "text": "حيوان يبني عشه فوق الشجرة.",
      "hash": "8a34cb4568c689c3",
      "durationMs": 2811,
      "bytes": 23030
    },
    "ar/r/habitats-land-water-1": {
      "text": "حيوان يعيش في الماي.",
      "hash": "22c14b0cdf393482",
      "durationMs": 1887,
      "bytes": 15716
    },
    "ar/r/habitats-land-water-2": {
      "text": "حيوان يعيش على اليابسة.",
      "hash": "67d40f2319c1005b",
      "durationMs": 2213,
      "bytes": 18224
    },
    "ar/r/habitats-land-water-3": {
      "text": "نبات ينبت في الماي.",
      "hash": "5b2f399c25c8e023",
      "durationMs": 2172,
      "bytes": 18015
    },
    "ar/r/habitats-land-water-4": {
      "text": "نبات ينبت على اليابسة.",
      "hash": "eaeb46f94002f086",
      "durationMs": 2561,
      "bytes": 21149
    },
    "ar/r/protect-harm-places-1": {
      "text": "رقم واحد… أضرار التربة.",
      "hash": "6f12164145edd44e",
      "durationMs": 2714,
      "bytes": 22194
    },
    "ar/r/protect-harm-places-2": {
      "text": "رقم اثنين… أضرار الهوا.",
      "hash": "7855a3bb7c69d18e",
      "durationMs": 2535,
      "bytes": 20940
    },
    "ar/r/protect-harm-places-3": {
      "text": "رقم ثلاثة… أضرار الماي.",
      "hash": "20c7ea9372f42a6b",
      "durationMs": 2663,
      "bytes": 21776
    },
    "ar/r/protect-harms-1": {
      "text": "سلوك يضر الهوا.",
      "hash": "7ad12505a5377c61",
      "durationMs": 1934,
      "bytes": 16134
    },
    "ar/r/protect-harms-2": {
      "text": "سلوك يضر الماي.",
      "hash": "41bf67df6a6fc9b0",
      "durationMs": 1896,
      "bytes": 15716
    },
    "ar/r/protect-harms-3": {
      "text": "سلوك يضر النباتات.",
      "hash": "937d266600ba2639",
      "durationMs": 2160,
      "bytes": 17806
    },
    "ar/r/protect-harms-4": {
      "text": "سلوك يضر الأماكن العامة.",
      "hash": "a1c65126cdfdde56",
      "durationMs": 2480,
      "bytes": 20314
    },
    "ar/r/protect-protect-ways-1": {
      "text": "نزرع النباتات.",
      "hash": "e44d93e04c1c5597",
      "durationMs": 1533,
      "bytes": 12790
    },
    "ar/r/protect-protect-ways-2": {
      "text": "نقط الزبالة في مكانها.",
      "hash": "f1e7fcca1ad79668",
      "durationMs": 2080,
      "bytes": 17179
    },
    "ar/r/protect-protect-ways-3": {
      "text": "نستخدم أكياس القماش.",
      "hash": "8833edaa544bebb5",
      "durationMs": 2080,
      "bytes": 17179
    },
    "ar/r/protect-protect-ways-4": {
      "text": "نستخدم السيكل.",
      "hash": "bfb6fdb4b4130e82",
      "durationMs": 1532,
      "bytes": 12790
    },
    "ar/r/protect-protect-ways-5": {
      "text": "نفرز النفايات عشان نعيد تدويرها.",
      "hash": "2d55964507a6278b",
      "durationMs": 2794,
      "bytes": 22821
    },
    "ar/ui/board-wrong-1": {
      "text": "لا مو هذا… نجرب غيره.",
      "hash": "0b988c8cb0f4060d",
      "durationMs": 2800,
      "bytes": 23030
    },
    "ar/ui/board-wrong-2": {
      "text": "امم… مو هني مكانه.",
      "hash": "52ed28833672d842",
      "durationMs": 2339,
      "bytes": 19269
    },
    "ar/ui/board-wrong-3": {
      "text": "شوي بعد… نطالع مرة ثانية.",
      "hash": "1cf1f340b54e52ea",
      "durationMs": 2703,
      "bytes": 22194
    },
    "ar/ui/boys/cheer-1": {
      "text": "يا بطل!",
      "hash": "c1c1713d7fb2e07b",
      "durationMs": 1082,
      "bytes": 9238
    },
    "ar/ui/boys/cheer-2": {
      "text": "يا شاطر!",
      "hash": "5878dba3803a8e90",
      "durationMs": 1268,
      "bytes": 10700
    },
    "ar/ui/boys/cheer-3": {
      "text": "يا عالم صغير!",
      "hash": "dad03300f90c427a",
      "durationMs": 1680,
      "bytes": 14044
    },
    "ar/ui/boys/done-great-1": {
      "text": "إنت عالم صغير!",
      "hash": "7e860fcd477d5624",
      "durationMs": 1652,
      "bytes": 13835
    },
    "ar/ui/cheer-1": {
      "text": "فديت هالجواب!",
      "hash": "d7f0e72cbbe382ca",
      "durationMs": 1666,
      "bytes": 13835
    },
    "ar/ui/cheer-10": {
      "text": "زين زين زين!",
      "hash": "3976f2892ea222ff",
      "durationMs": 1919,
      "bytes": 15925
    },
    "ar/ui/cheer-11": {
      "text": "من أول مرة… صح!",
      "hash": "19c1aab0d57ceaf6",
      "durationMs": 2514,
      "bytes": 20732
    },
    "ar/ui/cheer-12": {
      "text": "فكرة حلوة… وجواب صح!",
      "hash": "9bafb83a5fce8bb3",
      "durationMs": 2480,
      "bytes": 20314
    },
    "ar/ui/cheer-13": {
      "text": "طلع صح!",
      "hash": "71f8b9d4d7f63414",
      "durationMs": 1030,
      "bytes": 8820
    },
    "ar/ui/cheer-14": {
      "text": "صح صح صح!",
      "hash": "bb4f810bebec6692",
      "durationMs": 1738,
      "bytes": 14462
    },
    "ar/ui/cheer-2": {
      "text": "يا سلام عليه من جواب!",
      "hash": "dad930bb7850b75e",
      "durationMs": 2356,
      "bytes": 19478
    },
    "ar/ui/cheer-3": {
      "text": "الله الله… جواب علماء!",
      "hash": "e448f413580f2f50",
      "durationMs": 3140,
      "bytes": 25747
    },
    "ar/ui/cheer-4": {
      "text": "تبارك الرحمن!",
      "hash": "489c8469e9f4b1f4",
      "durationMs": 1756,
      "bytes": 14671
    },
    "ar/ui/cheer-5": {
      "text": "بالضبط جذي!",
      "hash": "2646c1ac3609b036",
      "durationMs": 1360,
      "bytes": 11536
    },
    "ar/ui/cheer-6": {
      "text": "إي والله صح!",
      "hash": "7bb52b30a973bda8",
      "durationMs": 1733,
      "bytes": 14462
    },
    "ar/ui/cheer-7": {
      "text": "جواب يبيض الوجه!",
      "hash": "c60414fb0ae6afb4",
      "durationMs": 2346,
      "bytes": 19269
    },
    "ar/ui/cheer-8": {
      "text": "حلو حيل!",
      "hash": "7516e7dde09e7045",
      "durationMs": 1520,
      "bytes": 12790
    },
    "ar/ui/cheer-9": {
      "text": "هذا هو الجواب!",
      "hash": "663025e8c783dd91",
      "durationMs": 1479,
      "bytes": 12372
    },
    "ar/ui/cheer-color-1": {
      "text": "ألوان حلوة… وكلها صح!",
      "hash": "4d94d8a6ac53edc0",
      "durationMs": 2758,
      "bytes": 22612
    },
    "ar/ui/cheer-habitats-1": {
      "text": "عرفنا وين يعيش!",
      "hash": "ef11cd24fca8ab6e",
      "durationMs": 1680,
      "bytes": 14044
    },
    "ar/ui/cheer-habitats-2": {
      "text": "حتى السمك فرحان!",
      "hash": "f4a8ab6e0df4b0e7",
      "durationMs": 1760,
      "bytes": 14671
    },
    "ar/ui/cheer-homes-1": {
      "text": "كل حيوان رجع بيته!",
      "hash": "2b3309c929203e53",
      "durationMs": 2096,
      "bytes": 17388
    },
    "ar/ui/cheer-homes-2": {
      "text": "البيوت كلها صح!",
      "hash": "757ee8074e9a9a35",
      "durationMs": 2024,
      "bytes": 16761
    },
    "ar/ui/cheer-numbers-1": {
      "text": "الأرقام كلها بمكانها!",
      "hash": "f3358f76a7e52ac0",
      "durationMs": 2099,
      "bytes": 17388
    },
    "ar/ui/cheer-numbers-2": {
      "text": "رقم رقم… وكلها صح!",
      "hash": "a784a217d0442e61",
      "durationMs": 3150,
      "bytes": 25747
    },
    "ar/ui/cheer-protect-1": {
      "text": "الأرض تقول: شكرا!",
      "hash": "6cf7b95089fee57c",
      "durationMs": 2320,
      "bytes": 19060
    },
    "ar/ui/cheer-protect-2": {
      "text": "البحر صار أنظف!",
      "hash": "69a5d2a78f82b08a",
      "durationMs": 1808,
      "bytes": 15089
    },
    "ar/ui/cheer-protect-3": {
      "text": "جذي نحمي بيئتنا!",
      "hash": "eb9cb27ee8b4e4fe",
      "durationMs": 1858,
      "bytes": 15507
    },
    "ar/ui/cheer-scene-1": {
      "text": "عيون صقر!",
      "hash": "c528f5eaf56a4801",
      "durationMs": 1155,
      "bytes": 9865
    },
    "ar/ui/cheer-scene-2": {
      "text": "ما فاتنا شي!",
      "hash": "4275be8b0cb73b58",
      "durationMs": 1207,
      "bytes": 10283
    },
    "ar/ui/done-good-1": {
      "text": "زين ما سوينا! ومرة ثانية نصير أحسن.",
      "hash": "09168a9b13eb512b",
      "durationMs": 3558,
      "bytes": 29091
    },
    "ar/ui/done-good-2": {
      "text": "خلصنا الجولة… والمرة الياية نجمع نجوم أكثر.",
      "hash": "5e34ad93561d1ed8",
      "durationMs": 4293,
      "bytes": 34942
    },
    "ar/ui/done-great-1": {
      "text": "خلصنا… والنتيجة تبيض الوجه!",
      "hash": "16e668a645675244",
      "durationMs": 3620,
      "bytes": 29509
    },
    "ar/ui/done-great-2": {
      "text": "كل النجوم! البر والبحر فرحانين.",
      "hash": "a2d177407c129759",
      "durationMs": 3572,
      "bytes": 29091
    },
    "ar/ui/girls/cheer-1": {
      "text": "يا بطلة!",
      "hash": "b8cc3e8215d3da84",
      "durationMs": 1149,
      "bytes": 9656
    },
    "ar/ui/girls/cheer-2": {
      "text": "يا شاطرة!",
      "hash": "6e9717c40952523b",
      "durationMs": 1360,
      "bytes": 11536
    },
    "ar/ui/girls/cheer-3": {
      "text": "يا عالمة صغيرة!",
      "hash": "2a9cc5e8d0f51ffe",
      "durationMs": 1593,
      "bytes": 13208
    },
    "ar/ui/girls/done-great-1": {
      "text": "إنتي عالمة صغيرة!",
      "hash": "8256017acc172fbf",
      "durationMs": 1765,
      "bytes": 14671
    },
    "ar/ui/retry-1": {
      "text": "ما عليه… الغلط يعلمنا.",
      "hash": "f7d4807b355c26d6",
      "durationMs": 2597,
      "bytes": 21358
    },
    "ar/ui/retry-2": {
      "text": "قربنا وايد! هذا هو الصح.",
      "hash": "4a10368fc6d58a03",
      "durationMs": 2818,
      "bytes": 23030
    },
    "ar/ui/retry-3": {
      "text": "هالمرة لا… بس الحين عرفناها.",
      "hash": "64d9d781b1561555",
      "durationMs": 2998,
      "bytes": 24493
    },
    "ar/ui/retry-4": {
      "text": "عادي… حتى العلماء يغلطون!",
      "hash": "f9465cf8542f3898",
      "durationMs": 2668,
      "bytes": 21985
    },
    "ar/ui/retry-5": {
      "text": "شوي شوي… ونصير أشطر.",
      "hash": "623a6c3957a2fefe",
      "durationMs": 2911,
      "bytes": 23866
    },
    "ar/ui/retry-6": {
      "text": "المحاولة حلوة… والصح هذا.",
      "hash": "bc213cea430f97d7",
      "durationMs": 2713,
      "bytes": 22194
    },
    "ar/ui/retry-7": {
      "text": "كل غلطة… درس جديد.",
      "hash": "f6bac63c5053fee2",
      "durationMs": 2555,
      "bytes": 20940
    },
    "ar/ui/review-1": {
      "text": "نطالع الحل الصح سوا…",
      "hash": "30e8433b5387b3b4",
      "durationMs": 1812,
      "bytes": 15089
    },
    "ar/ui/review-2": {
      "text": "هذا هو الحل… ونتعلم منه.",
      "hash": "31d789da71874f25",
      "durationMs": 2812,
      "bytes": 23030
    },
    "ar/ui/review-3": {
      "text": "خلنا نشوف وين الصح…",
      "hash": "bbbb529a46055d6f",
      "durationMs": 1990,
      "bytes": 16552
    },
    "ar/ui/streak-3-1": {
      "text": "ثلاثة على التوالي… يا سلام!",
      "hash": "25803d366a9bd109",
      "durationMs": 3211,
      "bytes": 26165
    },
    "ar/ui/streak-3-2": {
      "text": "ثلاثة صح… والرابع جاي!",
      "hash": "ec3e6a19ba7f48c2",
      "durationMs": 2552,
      "bytes": 20940
    },
    "ar/ui/streak-5-1": {
      "text": "خمسة على التوالي… شي ولا أروع!",
      "hash": "433b9d0fb824012e",
      "durationMs": 3600,
      "bytes": 29300
    },
    "ar/ui/streak-5-2": {
      "text": "خمس مرات صح! نجم العلوم!",
      "hash": "e202ec617bb09410",
      "durationMs": 2921,
      "bytes": 23866
    },
    "ar/ui/test-intro-1": {
      "text": "هذا نموذج اختبار… مثل ورقة المدرسة بالضبط.",
      "hash": "025ce121413b1e8e",
      "durationMs": 4103,
      "bytes": 33479
    },
    "ar/ui/test-intro-2": {
      "text": "يلا نجرب الاختبار… سؤال ورا سؤال، وعلى راحتنا.",
      "hash": "60cc92d351ef19e4",
      "durationMs": 4243,
      "bytes": 34524
    },
    "ar/ui/welcome-1": {
      "text": "حياكم! اليوم بنعرف وين تعيش الكائنات الحية… وشلون نحميها.",
      "hash": "6ad993ea61e2f8d1",
      "durationMs": 5520,
      "bytes": 44764
    },
    "ar/ui/welcome-2": {
      "text": "أهلا وسهلا! من البحر للبر… يلا نستكشف.",
      "hash": "d7ec1297787a09fb",
      "durationMs": 4360,
      "bytes": 35360
    },
    "ar/ui/welcome-3": {
      "text": "مستعدين؟ البر والبحر ينطرونا!",
      "hash": "1671a7827feb7405",
      "durationMs": 3328,
      "bytes": 27210
    }
  }
