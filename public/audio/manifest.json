  "clips": {
    "f/b-crab": {
      "text": "وسرطان البحر بعد… يتنفس بالخياشيم.",
      "hash": "fbbc6afe15b12f49",
      "durationMs": 3641,
      "bytes": 29718
    },
    "f/b-fish-out": {
      "text": "السمكة تحتاج الماي عشان تعيش… إذا طلعت من الماي وقت طويل، تموت.",
      "hash": "9c0d9c3b99dd613f",
      "durationMs": 5809,
      "bytes": 47063
    },
    "f/b-gills": {
      "text": "أما السمكة والقرش… يتنفسون داخل الماي بالخياشيم.",
      "hash": "2a2bb379445e63df",
      "durationMs": 4633,
      "bytes": 37659
    },
    "f/b-like-us": {
      "text": "الحيوانات تتنفس مثلنا… بس مو كلها بنفس الطريقة.",
      "hash": "0757d27307613c23",
      "durationMs": 4369,
      "bytes": 35569
    },
    "f/b-lungs": {
      "text": "القطة، والأرنب، والدجاجة، والسلحفاة… تتنفس الهوا بالرئتين، مثلنا بالضبط.",
      "hash": "2c30ea113d569815",
      "durationMs": 7456,
      "bytes": 60229
    },
    "f/b-lungs-more": {
      "text": "والزرافة، والدب، والطيور… بعد تتنفس بالرئتين.",
      "hash": "7f1d2b6dd7ac575a",
      "durationMs": 4878,
      "bytes": 39540
    },
    "f/boys/r-nest": {
      "text": "إذا شفت بيض في عش… فهذا بيض طيور، مثل الحمامة والعصفور.",
      "hash": "b636ffb1b1f32246",
      "durationMs": 5539,
      "bytes": 44973
    },
    "f/c-birds": {
      "text": "الطيور جسمها مغطى بريش… مثل الببغاء، والبطريق، والبطة.",
      "hash": "abd4c084f7725250",
      "durationMs": 5549,
      "bytes": 44973
    },
    "f/c-crocodile": {
      "text": "التمساح جسمه مغطى بحراشف… قوية وخشنة.",
      "hash": "84d259b76a2e8de9",
      "durationMs": 4884,
      "bytes": 39540
    },
    "f/c-different": {
      "text": "كل حيوان له غطا يغطي جسمه… والأغطية مو نفس الشي، مختلفة.",
      "hash": "9ff3d162f03951c4",
      "durationMs": 5990,
      "bytes": 48526
    },
    "f/c-duck": {
      "text": "وريش البطة يمنع الماي يدخل جسمها… عشان جذي ما تتبلل وهي تسبح.",
      "hash": "3f1d310859ff73a5",
      "durationMs": 6047,
      "bytes": 48944
    },
    "f/c-fish": {
      "text": "السمكة جسمها مغطى بقشور… صغيرة ولامعة.",
      "hash": "482e875b8c52493d",
      "durationMs": 4974,
      "bytes": 40376
    },
    "f/c-fur": {
      "text": "الثعلب، والأسد، والذئب… جسمهم مغطى بشعر.",
      "hash": "3e1554604535d3c8",
      "durationMs": 4720,
      "bytes": 38286
    },
    "f/c-protect": {
      "text": "وليش الغطا مهم؟ لأنه يحمي جسم الحيوان.",
      "hash": "ba0e11100d2ae753",
      "durationMs": 3773,
      "bytes": 30763
    },
    "f/c-turtle": {
      "text": "السلحفاة جسمها مغطى بصندوق عظمي… قوي، يحميها.",
      "hash": "ea543d2731f71a90",
      "durationMs": 5217,
      "bytes": 42256
    },
    "f/c-warm": {
      "text": "شعر الذئب يدفيه… عشان ما يبرد.",
      "hash": "c8efb05e93dd97c5",
      "durationMs": 3454,
      "bytes": 28255
    },
    "f/f-chain": {
      "text": "والحيوانات اللي تاكل لحوم… تاكل الحيوانات اللي تاكل أعشاب.",
      "hash": "3bd67c35211d1761",
      "durationMs": 5015,
      "bytes": 40585
    },
    "f/f-crocodile": {
      "text": "التمساح ياكل لحوم حيوانات ثانية.",
      "hash": "8c10d99dde114375",
      "durationMs": 3087,
      "bytes": 25329
    },
    "f/f-different": {
      "text": "الحيوانات مو كلها تاكل نفس الأكل… أكلها مختلف.",
      "hash": "d4157d484e3e3b15",
      "durationMs": 4216,
      "bytes": 34315
    },
    "f/f-elephant": {
      "text": "والفيل، والزرافة… بعد ياكلون نباتات.",
      "hash": "a941c1e9ab0b6da1",
      "durationMs": 3942,
      "bytes": 32016
    },
    "f/f-lion": {
      "text": "الأسد ياكل لحوم… واللبوة تعطي صغارها لحم ياكلونه.",
      "hash": "c53f119ffe2decda",
      "durationMs": 5029,
      "bytes": 40794
    },
    "f/f-meat": {
      "text": "وفي حيوانات تاكل لحوم… مثل الذئب، والثعبان، والصقر.",
      "hash": "6773ad2eb710cc1d",
      "durationMs": 5053,
      "bytes": 41003
    },
    "f/f-plants": {
      "text": "في حيوانات تاكل نباتات… مثل الأرنب، والحصان، والجمل.",
      "hash": "92ae2334248a7640",
      "durationMs": 5207,
      "bytes": 42256
    },
    "f/m-crawl": {
      "text": "الثعبان ما عنده رجول… فيزحف على بطنه.",
      "hash": "05bdb317ac56fc5b",
      "durationMs": 3787,
      "bytes": 30763
    },
    "f/m-different": {
      "text": "الحيوانات تتحرك من مكان لمكان… بس كل حيوان له طريقته!",
      "hash": "e10e644df19721fb",
      "durationMs": 5473,
      "bytes": 44346
    },
    "f/m-duck": {
      "text": "في حيوانات تتحرك بأكثر من طريقة… البطة: تسبح في الماي، وتمشي على الأرض، وتطير في السما!",
      "hash": "5cf9fb4342430a56",
      "durationMs": 8363,
      "bytes": 67543
    },
    "f/m-fly": {
      "text": "الطيور تطير بجناحاتها في السما… مثل الببغاء، والحمامة، والبومة.",
      "hash": "45c2277e4c03a545",
      "durationMs": 5911,
      "bytes": 47899
    },
    "f/m-jump": {
      "text": "الأرنب يقفز… والكنغر يقفز قفزات كبيرة!",
      "hash": "ad474f46624bc7e2",
      "durationMs": 4986,
      "bytes": 40376
    },
    "f/m-penguin": {
      "text": "والبطريق يمشي ويسبح… بس ما يطير.",
      "hash": "d6c6bb5508167b1d",
      "durationMs": 3686,
      "bytes": 30136
    },
    "f/m-seaturtle": {
      "text": "والسلحفاة البحرية… تزحف على الرمل، وتسبح في البحر.",
      "hash": "754869975f593338",
      "durationMs": 4584,
      "bytes": 37241
    },
    "f/m-swim": {
      "text": "السمكة تسبح في الماي… والحوت بعد يسبح.",
      "hash": "e695cd29225dd1b5",
      "durationMs": 3629,
      "bytes": 29509
    },
    "f/m-walk": {
      "text": "الحصان يمشي على رجوله… والكلب والأسد بعد يمشون.",
      "hash": "3cfbbb9deed887d1",
      "durationMs": 4796,
      "bytes": 38913
    },
    "f/p-carrot": {
      "text": "الجزر… هو جذر النبتة! ينمو تحت التراب، وإحنا ناكله.",
      "hash": "27983845da8722c9",
      "durationMs": 5337,
      "bytes": 43301
    },
    "f/p-cauliflower": {
      "text": "القرنبيط… الجزء الأبيض اللي ناكله هو زهرته. والبروكلي بعد ناكل زهرته.",
      "hash": "0b0be4dc9b9b3eb9",
      "durationMs": 6474,
      "bytes": 52287
    },
    "f/p-different": {
      "text": "يعني… مو كل النباتات ناكل منها نفس الجزء! من الجزر ناكل الجذر، ومن الخس ناكل الأوراق، ومن القرنبيط ناكل الزهرة.",
      "hash": "5d7521c57abd6010",
      "durationMs": 10126,
      "bytes": 81545
    },
    "f/p-flower": {
      "text": "والزهرة… في نباتات ناكل زهرتها، مثل: القرنبيط، والبروكلي.",
      "hash": "15edb342b6a2fd76",
      "durationMs": 6004,
      "bytes": 48526
    },
    "f/p-leaf": {
      "text": "الأوراق لونها أخضر… وفي أوراق ناكلها، مثل: الخس، والنعناع.",
      "hash": "b425b380a6f459fa",
      "durationMs": 5812,
      "bytes": 47063
    },
    "f/p-lettuce": {
      "text": "الخس… ناكل أوراقه الخضرا.",
      "hash": "14213fa26be1279a",
      "durationMs": 2668,
      "bytes": 21985
    },
    "f/p-parts": {
      "text": "النبات له أربعة أجزاء… الجذر، والساق، والأوراق، والزهرة.",
      "hash": "d6a2e3e9d10b39d6",
      "durationMs": 5804,
      "bytes": 47063
    },
    "f/p-radish": {
      "text": "وفي نباتات ناكل منها أكثر من جزء… مثل الفجل الأبيض: ناكل جذره الأبيض، وناكل أوراقه بعد.",
      "hash": "d2ff55404491a6ab",
      "durationMs": 7881,
      "bytes": 63572
    },
    "f/p-root": {
      "text": "الجذر يكون تحت التراب… ويشرب الماي للنبتة. ومن الجذور اللي ناكلها: الجزر.",
      "hash": "04e428dba565666b",
      "durationMs": 7019,
      "bytes": 56676
    },
    "f/p-stem": {
      "text": "الساق يشيل النبتة ويخليها واقفة… ومن السيقان اللي ناكلها: قصب السكر.",
      "hash": "e68c9b08206b74b2",
      "durationMs": 6357,
      "bytes": 51452
    },
    "f/p-sugarcane": {
      "text": "قصب السكر… ناكل ساقه الطويل، ومنه يسوون السكر.",
      "hash": "c68c14568fd7df4c",
      "durationMs": 4687,
      "bytes": 38077
    },
    "f/r-birds": {
      "text": "وكل الطيور تتكاثر بالبيض… مثل الدجاجة، والعصفور، والبطة.",
      "hash": "bb7c4431f074c03c",
      "durationMs": 5549,
      "bytes": 44973
    },
    "f/r-birth": {
      "text": "القطة، والخروف، والدب… تتكاثر بالولادة: تولد صغارها.",
      "hash": "97d2cd8e64c2d47a",
      "durationMs": 5857,
      "bytes": 47481
    },
    "f/r-eggs": {
      "text": "والسلحفاة، والسمكة… تتكاثر بالبيض.",
      "hash": "20f6e2c6abdf4065",
      "durationMs": 3856,
      "bytes": 31389
    },
    "f/r-giraffe": {
      "text": "الزرافة… تاكل نباتات، وتتكاثر بالولادة.",
      "hash": "e2649bc671cbbb86",
      "durationMs": 4139,
      "bytes": 33688
    },
    "f/r-nest": {
      "text": "إذا شفتي بيض في عش… فهذا بيض طيور، مثل الحمامة والعصفور.",
      "hash": "784dfa17b71a01b8",
      "durationMs": 5377,
      "bytes": 43510
    },
    "f/r-ways": {
      "text": "الحيوانات تتكاثر… يعني تجيب صغار. وفيه طريقتين: الولادة، والبيض.",
      "hash": "ad6ebb07e5db53b7",
      "durationMs": 6705,
      "bytes": 54168
    },
