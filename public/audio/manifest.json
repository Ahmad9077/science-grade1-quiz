  "clips": {
    "ar/f/bike": {
      "text": "السيكل ما يطلع دخان… فهو أحسن للهوا من السيارة.",
      "hash": "fb94eb5e41f263ae",
      "durationMs": 4690,
      "bytes": 38077
    },
    "ar/f/burning": {
      "text": "لما نحرق الزبالة… الدخان يوصخ الهوا، والرماد يضر التربة.",
      "hash": "e53c155e5fcf0a5b",
      "durationMs": 5517,
      "bytes": 44764
    },
    "ar/f/burrow": {
      "text": "الجحر حفرة في الأرض… يسكن فيها الأرنب، والحصني بعد.",
      "hash": "bb2a13ecd28d99fe",
      "durationMs": 5330,
      "bytes": 43301
    },
    "ar/f/clean-beach": {
      "text": "الشاطي النظيف… نلعب فيه ونسبح بأمان. أما الوصخ، فيضرنا ويضر السمك.",
      "hash": "407335b484fd528c",
      "durationMs": 7220,
      "bytes": 58348
    },
    "ar/f/cloth-bag": {
      "text": "كيس القماش… نستخدمه مرة ومرتين وثلاث، بدل كيس البلاستيك.",
      "hash": "7fd2eca8ccc7d998",
      "durationMs": 5843,
      "bytes": 47272
    },
    "ar/f/dead-fish": {
      "text": "السمكة ماتت… لأن الناس قطوا الزبالة في البحر.",
      "hash": "6d85fa3121a96b4f",
      "durationMs": 4217,
      "bytes": 34315
    },
    "ar/f/harm-animals": {
      "text": "لما نوصخ البحر والبر… الحيوانات تمرض، وممكن تموت.",
      "hash": "99082a5e62705045",
      "durationMs": 4945,
      "bytes": 40167
    },
    "ar/f/harm-behaviors": {
      "text": "في أشياء تضر الأماكن اللي تعيش فيها الكائنات… مثل رمي الزبالة، ودخان المصانع، وقطع الشجر، ودخان السيارات.",
      "hash": "1bee230db03ae53b",
      "durationMs": 9520,
      "bytes": 76738
    },
    "ar/f/harm-places": {
      "text": "أكياس الزبالة على الأرض تضر التربة… والدخان فوق يضر الهوا… والزبالة في الماي تضر الماي.",
      "hash": "9e930ca9a0350426",
      "durationMs": 8455,
      "bytes": 68170
    },
    "ar/f/in-water": {
      "text": "الأخطبوط، والسمكة، والمرجان… بيتهم الماي، ما يعيشون برا البحر.",
      "hash": "89fa7f7c9aac7f00",
      "durationMs": 5893,
      "bytes": 47690
    },
    "ar/f/land-places": {
      "text": "على اليابسة… في الغابة، والصحرا، والثلج، والسهول… كلها أماكن تعيش فيها الكائنات الحية.",
      "hash": "c191191f58775455",
      "durationMs": 8355,
      "bytes": 67334
    },
    "ar/f/land-water": {
      "text": "في كائنات تعيش على اليابسة… يعني على الأرض. وفي كائنات تعيش في الماي.",
      "hash": "e82cc3db9d84bd9d",
      "durationMs": 6320,
      "bytes": 51034
    },
    "ar/f/litter-harm": {
      "text": "القواطي، والأكياس، والدخان… كلها تضر المكان اللي نلعب فيه.",
      "hash": "356e9c6b8d32d737",
      "durationMs": 5545,
      "bytes": 44973
    },
    "ar/f/lost-home": {
      "text": "إذا الحيوان خسر بيته… ما يلقى مكان يحميه من المطر والبرد والخطر.",
      "hash": "7729a9073815cfc2",
      "durationMs": 5717,
      "bytes": 46227
    },
    "ar/f/nest": {
      "text": "العش… بيت الطيور. تبنيه فوق الشجرة، وتحط فيه بيضها.",
      "hash": "eb243d78fabd959f",
      "durationMs": 5255,
      "bytes": 42674
    },
    "ar/f/on-land": {
      "text": "الجمل، والسحلية، والنخلة… كلهم يعيشون على اليابسة، في البر.",
      "hash": "8d6891f24aec29b2",
      "durationMs": 5954,
      "bytes": 48108
    },
    "ar/f/places-differ": {
      "text": "الكائنات الحية… مو كلها تعيش بنفس المكان. كل واحد له مكان يناسبه.",
      "hash": "cd457a0c848edc13",
      "durationMs": 6124,
      "bytes": 49571
    },
    "ar/f/plant-trees": {
      "text": "نزرع الشجر… وما نقطعه. الشجر ينظف الهوا، ويصير بيت للطيور.",
      "hash": "dc9bdb9bb75de467",
      "durationMs": 6144,
      "bytes": 49780
    },
    "ar/f/plants-harmed": {
      "text": "إذا النبات تضرر… الكائنات الثانية بعد تمرض أو تموت، لأنها تحتاجه.",
      "hash": "06cba91c813f5507",
      "durationMs": 6472,
      "bytes": 52287
    },
    "ar/f/polar-water": {
      "text": "في الصورة… الحوت والسمكة بس يعيشون في الماي. الباقين يمشون على الثلج.",
      "hash": "96c4678a88760dd5",
      "durationMs": 6166,
      "bytes": 49989
    },
    "ar/f/put-in-bin": {
      "text": "الزبالة مكانها السلة… مو الأرض، ولا البحر.",
      "hash": "ed1114b216dcbd6d",
      "durationMs": 4006,
      "bytes": 32643
    },
    "ar/f/recycle": {
      "text": "إعادة التدوير… يعني نسوي من النفايات أشياء جديدة، وتقل الزبالة في أرضنا.",
      "hash": "2730fa3cb3ceba4f",
      "durationMs": 6935,
      "bytes": 56049
    },
    "ar/f/sea-animals": {
      "text": "الحوت، والدلفين، والقرش… يسبحون في البحر. أما الحمار الوحشي، فيمشي على اليابسة.",
      "hash": "dcac5aa33a1f2e3c",
      "durationMs": 7728,
      "bytes": 62318
    },
    "ar/f/sea-mistake": {
      "text": "الأرنب والعصفور… مكانهم مو في البحر! الأرنب على اليابسة، والعصفور فوق الشجر.",
      "hash": "f0169d9f61cf817a",
      "durationMs": 7171,
      "bytes": 57930
    },
    "ar/f/sea-rocks": {
      "text": "والسمك… يتخبى بين الصخور والمرجان اللي في البحر. هذا بيته.",
      "hash": "858c24d80e71392f",
      "durationMs": 5125,
      "bytes": 41629
    },
    "ar/f/shelter-differs": {
      "text": "مو كل الحيوانات لها نفس البيت… العصفور له عش، والأرنب له جحر، والسمكة لها صخور البحر.",
      "hash": "9c28d6a69a05f614",
      "durationMs": 8606,
      "bytes": 69424
    },
    "ar/f/shelter-why": {
      "text": "المأوى هو بيت الحيوان… يحميه من الخطر، ويساعده يعيش ويبقى.",
      "hash": "59601c7a3cb0980d",
      "durationMs": 5662,
      "bytes": 45809
    },
    "ar/f/smoke-sick": {
      "text": "دخان المصانع يوصخ الهوا… والناس يمرضون، ويكحون، ويصعب عليهم التنفس.",
      "hash": "7a326cc9ed1e39a7",
      "durationMs": 6760,
      "bytes": 54586
    },
    "ar/f/sort-food": {
      "text": "بقايا الأكل، والقشور… مكانها صندوق نفايات الأطعمة.",
      "hash": "2ad705252ace59dd",
      "durationMs": 4874,
      "bytes": 39540
    },
    "ar/f/sort-paper": {
      "text": "الورق… مكانه صندوق النفايات الورقية.",
      "hash": "d5c1e2c8052bcd85",
      "durationMs": 3754,
      "bytes": 30554
    },
    "ar/f/sort-plastic": {
      "text": "البلاستيك… مكانه صندوق النفايات البلاستيكية.",
      "hash": "0ae79c0d8341c321",
      "durationMs": 4077,
      "bytes": 33270
    },
    "ar/f/tree-home": {
      "text": "السنجاب… يسكن في الشجرة، داخل فتحة في جذعها.",
      "hash": "c74019b1df9cb6e9",
      "durationMs": 5200,
      "bytes": 42256
    },
    "ar/f/turtle-plastic": {
      "text": "السلحفاة أحيانا تحسب كيس البلاستيك أكل… وتاكله وتمرض.",
      "hash": "9a26394ea1f541af",
      "durationMs": 5701,
      "bytes": 46227
    },
    "ar/f/waste-harm": {
      "text": "الزبالة في البحر وفي البر… تضر الكائنات الحية، وتخرب بيوتها.",
      "hash": "7d8ca4feaee4a686",
      "durationMs": 5453,
      "bytes": 44137
    },
    "ar/f/water-places": {
      "text": "وفي الماي… البحر، والشعاب المرجانية… مليانة كائنات حية.",
